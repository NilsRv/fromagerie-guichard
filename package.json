{
  "name": "fromagerie-guichard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/index.js --dev",
    "build": "vite build",
    "start": "node server/index.js",
    "preview": "node server/index.js",
    "orders": "node server/orders.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.mjs",
    "format": "prettier --write src server tests index.html vite.config.js package.json",
    "format:check": "prettier --check src server tests index.html vite.config.js package.json",
    "check": "npm test && npm run format:check && npm run build",
    "test:quick-shop": "node audit/quick-shop-check.mjs",
    "test:commerce": "node audit/commerce-interactions-check.mjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "lenis": "^1.3.11",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.51.1",
    "prettier": "^3.9.10",
    "vite": "^6.1.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
